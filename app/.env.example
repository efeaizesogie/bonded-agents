# Server-side (Next.js API route + CLI scripts)
# Model key: NVIDIA (free, build.nvidia.com, starts with nvapi-) is used when set; otherwise Anthropic.
NVIDIA_API_KEY=nvapi-...
# LLM_MODEL=moonshotai/kimi-k2.6  (listed by NVIDIA but currently not served)
ANTHROPIC_API_KEY=sk-ant-...
# Contents of keys/arbiter.json (JSON byte array) or a base58 secret key
ARBITER_SECRET_KEY=[...]
# Optional custom RPC (Helius/Triton/etc.) — defaults to public devnet
# RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Browser: sign the wallet out after this many hours without activity (default 2)
# NEXT_PUBLIC_SESSION_TIMEOUT_HOURS=2
